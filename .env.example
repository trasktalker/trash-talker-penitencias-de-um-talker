# .env.example
# ============
# Modelo do arquivo .env. Copie para .env (`cp .env.example .env`) e
# preencha. O .env está no .gitignore: nunca commite valores reais.

# --- Obrigatória ---------------------------------------------------------

# Banco PostgreSQL (local ou Neon). Sem ela o app não sobe.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/trashtalker

# --- Servidor ------------------------------------------------------------

# Porta do `python app.py` (padrão 5000).
PORT=5000
# "production" desliga o modo debug e deixa o cookie de sessão Secure.
FLASK_ENV=development
# Origem pública do site: usada no CORS, no link do e-mail de redefinição
# de senha e na checagem de origem das rotas 2FA.
FRONTEND_ORIGIN=http://localhost:5000

# --- IA ------------------------------------------------------------------

# Chave do Google Gemini. Sem ela o app sobe, mas enviar mensagem e
# ouvir resposta (TTS) devolvem 502.
GEMINI_API_KEY=

# --- 2FA (Google Authenticator) ------------------------------------------

# Chave Fernet persistente. Sem ela o 2FA fica indisponível (503) e contas
# com 2FA não conseguem entrar. Não perca nem troque: ver docs/2fa.md
# (inclui o comando para gerar).
TOTP_ENCRYPTION_KEY=

# --- E-mail (opcional) ---------------------------------------------------

# Envio do e-mail de "esqueci minha senha". Sem SMTP_HOST, SMTP_USER e
# SMTP_PASSWORD, o link de redefinição é impresso no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente; se vazio, usa SMTP_USER.
SMTP_FROM=
